{
  "name": "climbing-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync": "cap sync ios",
    "build:local": "tsc --noEmit && vite build --mode development",
    "sync:local": "npm run build:local && cap sync ios",
    "dev:local": "./scripts/dev-local.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "postinstall": "patch-package",
    "migration:status": "node scripts/migration-status.mjs",
    "migration:apply": "node scripts/apply-migrations.mjs",
    "analyze:rpe-stability": "tsx scripts/analyze-rpe-stability.ts"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/bluetooth-le": "^8.2.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@sentry/react": "10.68.0",
    "@supabase/supabase-js": "^2.110.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sendlog-auth-bridge": "file:native-plugins/sendlog-auth-bridge",
    "sendlog-health": "file:native-plugins/sendlog-health",
    "sendlog-live-activity": "file:native-plugins/sendlog-live-activity",
    "sendlog-passkey": "file:native-plugins/sendlog-passkey"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.3",
    "supabase": "^2.109.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
