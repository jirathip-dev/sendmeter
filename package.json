{
  "name": "climbing-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run verify:pwa && npm run verify:production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=60000",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "preview": "vite preview",
    "verify:production": "node scripts/verify-production-artifacts.mjs",
    "sync": "cap sync ios",
    "build:local": "tsc --noEmit && vite build --mode development",
    "sync:local": "npm run build:local && cap sync ios",
    "dev:local": "./scripts/dev-local.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db:purge": "supabase test db --local supabase/tests/purge_sync_generation.sql",
    "test:db:health-precedence": "supabase test db --local supabase/tests/health_metrics_precedence.sql",
    "test:db:health-precedence-race": "bash scripts/test-health-precedence-race.sh",
    "db:status": "supabase status",
    "postinstall": "patch-package",
    "migration:status": "node scripts/migration-status.mjs",
    "migration:apply": "node scripts/apply-migrations.mjs",
    "analyze:rpe-stability": "tsx scripts/analyze-rpe-stability.ts",
    "verify:pwa": "node scripts/verify-pwa-chrome.mjs"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@sentry/react": "10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sendlog-auth-bridge": "file:native-plugins/sendlog-auth-bridge",
    "sendlog-health": "file:native-plugins/sendlog-health",
    "sendlog-live-activity": "file:native-plugins/sendlog-live-activity",
    "sendlog-passkey": "file:native-plugins/sendlog-passkey"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/node": "26.1.1",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.3",
    "supabase": "^2.115.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
