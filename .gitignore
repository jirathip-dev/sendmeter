# Xcode user/build state (per-machine, not project config)
xcuserdata/
.swiftpm/
DerivedData/
*.xcuserstate
# Generated by `xcodegen generate` — never commit (native/SendmeterNative/project.yml is the source of truth)
SendmeterNative.xcodeproj/
# SwiftPM build output (native-plugins/*/.build from `swift test`, etc.)
.build/

# The native SwiftUI target's Xcode project is GENERATED by `xcodegen
# generate` on every run (README, native-swift.yml, native_beta); only
# project.yml is committed. Ignoring the product keeps git status clean after
# gates.
native/SendmeterNative/SendmeterNative.xcodeproj/

