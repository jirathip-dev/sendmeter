<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- The Live Activity extension only renders the ActivityAttributes /
	     ContentState the app process pushes to it. It collects nothing. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- No required-reason API here. This bundle has no App Group and no
	     Button(intent:) (the guided protocol has no lock-screen actions;
	     interactive intents are iOS 17+ and a follow-up if ever added). Not
	     strictly required by Apple (a bundle that uses no required-reason
	     API needs no manifest), but kept so every shipped bundle states its
	     position explicitly. This file MUST be named PrivacyInfo.xcprivacy
	     at the appex bundle root — Apple's manifest tooling reads exactly
	     that name (#674 review F4). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
