<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- The Live Activity extension only renders the ActivityAttributes /
	     ContentState the app process pushes to it. It collects nothing. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- 1C8F.1 — UserDefaults(suiteName: "group.com.jirathip.sendlog") in
	     ReadinessWidgetStore, reading the account-stamped snapshot the app
	     writes. App-group access, so CA92.1 does not apply. This file MUST be
	     named PrivacyInfo.xcprivacy at the appex bundle root — Apple's manifest
	     tooling reads exactly that name (#674 review F4). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
