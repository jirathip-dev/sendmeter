# Copy this to `fastlane/.env` (gitignored) and fill in your values.
# Fastlane auto-loads fastlane/.env when you run a lane.
#
# Generate the key once at:
#   App Store Connect → Users and Access → Integrations →
#   App Store Connect API → "+" → role "App Manager".
# Download the .p8 (you only get one chance) and note its Key ID + the
# Issuer ID shown on that page.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Path (relative to repo root) to the downloaded .p8 — keep it out of git.
ASC_KEY_PATH=fastlane/asc_api_key.p8

# CI only (ENV["CI"] set, e.g. by GitHub Actions): the beta lane imports the
# team's existing Apple Distribution cert instead of minting a new one.
# Store these as secrets on a GitHub "testflight" environment, not here.
#   IOS_DIST_CERT_P12=<base64 of the exported SH947DTWM4.p12>
#   IOS_DIST_CERT_PASSWORD=<that p12's export password>
# The CI job must also write the ASC_KEY_P8 secret to the path ASC_KEY_PATH
# points at (fastlane/asc_api_key.p8) before running the lane.
