require "base64"
require "fastimage"
require "fileutils"
require "json"
require "shellwords"
require "xcodeproj"

default_platform(:ios)

APP_IDENTIFIER = "com.jirathip.sendlog".freeze
# The native SwiftUI target ships to TestFlight under a DISTINCT bundle ID
# (one bundle ID = one app slot on TestFlight; uploading the native build
# under the shipped ID would REPLACE the Capacitor app's builds — #637).
# The `.native` suffix means WCSession no longer pairs with the watch app
# (the companion relationship is bundle-ID-prefix-based, so the watch app
# com.jirathip.sendlog.watchkitapp only pairs with an iOS app whose ID is a
# prefix of it); the mirror falls back to the realtime server path. This is
# the accepted pre-promotion tradeoff — see docs/native-swift-rewrite.md.
NATIVE_APP_IDENTIFIER = "com.jirathip.sendlog.native".freeze
NATIVE_PROJECT_DIR = "native/SendmeterNative".freeze
NATIVE_XCODEPROJ = "#{NATIVE_PROJECT_DIR}/SendmeterNative.xcodeproj".freeze
NATIVE_SCHEME = "SendmeterNative".freeze
XCODEPROJ = "ios/App/App.xcodeproj".freeze
TEAM_ID = "9244PWFYD7".freeze
SCREENSHOT_OUTPUT = File.expand_path("screenshots", __dir__).freeze
SCREENSHOT_DERIVED_DATA = File.join(
  Dir.home,
  "Library/Developer/Xcode/DerivedData/SendmeterScreenshots"
).freeze
WATCH_SCREENSHOT_DEVICES = [
  "Apple Watch SE 3 (40mm)",
  "Apple Watch Ultra 3 (49mm)",
].freeze

def ensure_screenshot_simulator(name, platform)
  devices = JSON.parse(`xcrun simctl list devices available -j`).fetch("devices")
  return if devices.values.flatten.any? { |device| device["name"] == name }

  types = JSON.parse(`xcrun simctl list devicetypes -j`).fetch("devicetypes")
  device_type = types.find { |type| type["name"] == name }
  UI.user_error!("Xcode does not include the #{name} simulator type") unless device_type

  runtimes = JSON.parse(`xcrun simctl list runtimes available -j`).fetch("runtimes")
  runtime = runtimes
    .select { |candidate| candidate["name"].start_with?(platform) }
    .max_by { |candidate| candidate.fetch("version").split(".").map(&:to_i) }
  UI.user_error!("Xcode has no available #{platform} simulator runtime") unless runtime

  sh(
    "xcrun simctl create #{Shellwords.escape(name)} " \
    "#{Shellwords.escape(device_type.fetch('identifier'))} " \
    "#{Shellwords.escape(runtime.fetch('identifier'))}"
  )
end

def prepare_local_screenshot_fixture
  root = File.expand_path("..", __dir__)
  env_path = File.join(root, ".env.development.local")
  previous_env = File.exist?(env_path) ? File.binread(env_path) : nil

  # This is the disposable local stack only. Never use the hosted reviewer
  # account for automated screenshots: its contents and credentials are both
  # non-deterministic and production-sensitive.
  sh("cd #{Shellwords.escape(root)} && npx supabase start")
  status = sh(
    "cd #{Shellwords.escape(root)} && npx supabase status -o env",
    log: false
  )
  local = status.lines.filter_map do |line|
    match = line.strip.match(/\A(API_URL|PUBLISHABLE_KEY)=(.*)\z/)
    next unless match
    [match[1], match[2].strip.delete_prefix('"').delete_suffix('"')]
  end.to_h
  missing = %w[API_URL PUBLISHABLE_KEY] - local.keys
  UI.user_error!("Local Supabase status omitted #{missing.join(', ')}") unless missing.empty?

  File.write(
    env_path,
    "# Generated temporarily by fastlane screenshots\n" \
    "VITE_SUPABASE_URL=#{local.fetch('API_URL')}\n" \
    "VITE_SUPABASE_ANON_KEY=#{local.fetch('PUBLISHABLE_KEY')}\n"
  )

  begin
    sh("cd #{Shellwords.escape(root)} && npm run db:reset && npm run sync:local")
  ensure
    # Preserve the caller's local-dev selection. The compiled Capacitor bundle
    # already contains the fixture URL, so snapshot does not need this file.
    previous_env.nil? ? FileUtils.rm_f(env_path) : File.binwrite(env_path, previous_env)
  end
end

def verify_screenshot_output(devices: nil)
  expected = {
    "iPhone 17 Pro Max" => { count: 4, size: [1320, 2868] },
    "iPhone 13 Pro Max" => { count: 4, size: [1284, 2778] },
    "iPad Pro 13-inch (M5)" => { count: 4, size: [2064, 2752] },
    "Apple Watch SE 3 (40mm)" => { count: 2, size: [324, 394] },
    "Apple Watch Ultra 3 (49mm)" => { count: 2, size: [422, 514] },
  }
  expected.select! { |device, _| devices.include?(device) } if devices

  expected.each do |device, requirement|
    files = Dir[File.join(SCREENSHOT_OUTPUT, "**", "#{device}-*.png")].sort
    unless files.length == requirement.fetch(:count)
      UI.user_error!(
        "Expected #{requirement.fetch(:count)} #{device} screenshots, found #{files.length}"
      )
    end
    files.each do |file|
      actual = FastImage.size(file)
      next if actual == requirement.fetch(:size)
      UI.user_error!(
        "#{File.basename(file)} is #{actual&.join('x')}; expected " \
        "#{requirement.fetch(:size).join('x')}"
      )
    end
  end
end

def capture_watch_screenshot_output
  capture_screenshots(
    project: XCODEPROJ,
    scheme: "Sendmeter Watch Screenshots",
    configuration: "Debug",
    devices: WATCH_SCREENSHOT_DEVICES,
    languages: ["en-US"],
    output_directory: SCREENSHOT_OUTPUT,
    derived_data_path: SCREENSHOT_DERIVED_DATA,
    clear_previous_screenshots: false,
    erase_simulator: true,
    reinstall_app: true,
    concurrent_simulators: false,
    number_of_retries: 1,
    stop_after_first_error: true,
    skip_open_summary: true
  )
end

platform :ios do
  desc "Reset local fixtures and capture App Store iPhone, iPad + watch screenshots"
  lane :screenshots do
    ensure_screenshot_simulator("iPhone 17 Pro Max", "iOS")
    ensure_screenshot_simulator("iPhone 13 Pro Max", "iOS")
    ensure_screenshot_simulator("iPad Pro 13-inch (M5)", "iOS")
    ensure_screenshot_simulator("Apple Watch SE 3 (40mm)", "watchOS")
    ensure_screenshot_simulator("Apple Watch Ultra 3 (49mm)", "watchOS")
    prepare_local_screenshot_fixture

    # Apple currently needs the highest-resolution 6.9-inch iPhone and 13-inch
    # iPad families. Keep the issue's requested 6.5-inch iPhone set as an
    # additional Media Manager fallback. Run sequentially: this project must
    # never have concurrent xcodebuilds.
    capture_screenshots(
      project: XCODEPROJ,
      scheme: "Sendmeter Screenshots",
      configuration: "Debug",
      devices: [
        # Run the required iPad family first so iPad-only layout failures fail
        # fast instead of after both optional iPhone captures.
        "iPad Pro 13-inch (M5)",
        "iPhone 17 Pro Max",
        "iPhone 13 Pro Max",
      ],
      languages: ["en-US"],
      output_directory: SCREENSHOT_OUTPUT,
      derived_data_path: SCREENSHOT_DERIVED_DATA,
      clear_previous_screenshots: true,
      erase_simulator: true,
      reinstall_app: true,
      override_status_bar: true,
      concurrent_simulators: false,
      number_of_retries: 1,
      stop_after_first_error: true,
      skip_open_summary: true
    )

    # snapshot supports watchOS UI-test destinations, so the companion uses
    # the same named/organized output as iPhone instead of a one-off simctl
    # command. Run the compact SE before Ultra so the 40mm layout proof fails
    # fast; both devices execute the same production fixture/AX matrix.
    capture_watch_screenshot_output

    verify_screenshot_output
    UI.success("Verified App Store screenshots in #{SCREENSHOT_OUTPUT}")
  end

  desc "Regenerate and verify only the App Store watch screenshots"
  lane :watch_screenshots do
    WATCH_SCREENSHOT_DEVICES.each do |device|
      ensure_screenshot_simulator(device, "watchOS")
    end
    capture_watch_screenshot_output
    verify_screenshot_output(devices: WATCH_SCREENSHOT_DEVICES)
    UI.success("Verified App Store watch screenshots in #{SCREENSHOT_OUTPUT}")
  end

  desc "Build the web app, sync Capacitor, and ship a build to TestFlight"
  lane :beta do
    # App Store Connect API key — no Apple ID password / 2FA, works headless.
    # Generate at App Store Connect → Users and Access → Integrations →
    # App Store Connect API. See fastlane/.env.example.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    # 1. Fresh web assets into the native project (the easy-to-forget manual
    #    step — the archive bundles ios/App/App/public).
    sh("cd .. && npm run build && npx cap sync ios")

    # 2. Headless signing. get_certificates creates/installs an Apple
    #    Distribution certificate via the API key (no Xcode account, no match
    #    repo). The -authenticationKey* flags below then let the EXPORT step
    #    talk to App Store Connect without a signed-in Xcode account, which is
    #    what "exportArchive No Accounts" was complaining about. They are
    #    deliberately not given to the archive — see step 4.
    #
    #    On CI (ENV["CI"] set) get_certificates is unsafe: a fresh runner has
    #    an empty keychain, so it MINTS a new Apple Distribution cert every
    #    run — Apple caps these at 2-3/team, and a new cert invalidates
    #    profiles the laptop already has pinned to the old one. CI instead
    #    imports the team's single existing cert from a secret into a
    #    temporary keychain. Env contract for the CI job (a GitHub
    #    "testflight" environment, per the agent-ops CI/CD doctrine):
    #      CI=true (set automatically by GitHub Actions)
    #      IOS_DIST_CERT_P12       — base64 of the exported SH947DTWM4.p12
    #      IOS_DIST_CERT_PASSWORD  — that p12's export password
    #    plus ASC_KEY_ID / ASC_ISSUER_ID as today, and the workflow must
    #    write the ASC_KEY_P8 secret to fastlane/asc_api_key.p8 (the
    #    File.basename below resolves ASC_KEY_PATH relative to fastlane/, so
    #    -authenticationKeyPath needs a real file at that path either way).
    if ENV["CI"]
      setup_ci
      cert_path = File.expand_path("certs/dist.p12", __dir__)
      FileUtils.mkdir_p(File.dirname(cert_path))
      File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12")))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ""
      )
    else
      get_certificates(
        api_key: api_key,
        output_path: "fastlane/certs"
      )
    end
    key_abs = File.expand_path(File.basename(ENV.fetch("ASC_KEY_PATH")), __dir__)
    export_auth_args = "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
                       "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')} " \
                       "-authenticationKeyPath #{key_abs} -allowProvisioningUpdates"

    # The widget-extension App ID must exist before sigh can fetch a profile
    # for it — sigh does NOT create App IDs, and `produce`'s API-key support
    # is unreliable, so hit the ASC API directly (idempotent).
    widgets_id = "#{APP_IDENTIFIER}.widgets"
    watch_widgets_id = "#{APP_IDENTIFIER}.watchkitapp.widgets"
    [
      [widgets_id, "Sendmeter Widgets"],
      [watch_widgets_id, "Sendmeter Watch Widgets"],
    ].each do |id, name|
      existing = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: id })
      unless existing.any? { |b| b.identifier == id }
        Spaceship::ConnectAPI::BundleId.create(name: name, identifier: id, platform: "IOS")
        UI.message("Registered App ID #{id}")
      end
    end

    # NOTE (one-time manual step): the watch widgets read the watch app's data
    # via App Group `group.com.jirathip.sendlog`. Enable that App Group in the
    # Apple Developer portal on BOTH `#{APP_IDENTIFIER}.watchkitapp` and
    # `#{watch_widgets_id}` (Certificates, IDs & Profiles → the App ID →
    # Capabilities → App Groups). Until then, get_provisioning_profile below
    # will fail for the watch-widgets App ID with a capability-mismatch error.

    # Every signable target in the archive, mapped to its bundle id. Drives both
    # the profile fetch below and the per-target manual-signing pin in step 4, so
    # the two can't drift apart. (SendLogWatchTests is signable but isn't part of
    # the App scheme's archive action, so it stays on automatic signing.)
    signable = {
      "App" => APP_IDENTIFIER,
      "SendLogWatch Watch App" => "#{APP_IDENTIFIER}.watchkitapp",
      "SendmeterWidgets" => widgets_id,
      "SendLogWatchWidgets" => watch_widgets_id,
    }

    # App Store provisioning profiles that include the distribution cert above,
    # for the app + its embedded watch app + both widget extensions. force: true
    # regenerates them so they carry the current cert (the account's auto
    # "Team Store" profile referenced an older cert → "profile doesn't include
    # signing certificate"). Archive AND export then use manual signing with
    # these, avoiding Xcode cloud-managed signing, which the API key isn't
    # permitted to drive. sigh also *installs* each profile locally, which is
    # what lets the archive resolve them by name (step 4) — so if an archive
    # ever fails with "profile not found", that install is the thing to check.
    # The directory is Xcode-version-dependent
    # (fastlane_core/provisioning_profile.rb → profiles_path): Xcode 16+ uses
    # ~/Library/Developer/Xcode/UserData/Provisioning Profiles, older Xcodes
    # ~/Library/MobileDevice/Provisioning Profiles. Both this machine and the
    # macOS-26 CI runner are on the former; don't assume the legacy path exists.
    profiles = {}
    signable.each_value do |bundle_id|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle_id,
        force: true,
        output_path: "fastlane/certs"
      )
      profiles[bundle_id] = lane_context[SharedValues::SIGH_NAME]
    end

    # 3. Next build number = latest on TestFlight + 1. Applied as a build
    #    setting at archive time so it lands in BOTH the app and the embedded
    #    watch app, without mutating the git-tracked project.
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    ) + 1

    # 4. Pin the ARCHIVE to manual signing (#263).
    #
    #    gym runs two xcodebuild invocations: `archive`, then `-exportArchive`.
    #    export_options below governs only the export. The archive used whatever
    #    project.pbxproj says — and every target there is CODE_SIGN_STYLE =
    #    Automatic. On a fresh CI runner the keychain holds only the distribution
    #    cert imported above, so automatic signing found no Development identity,
    #    and `-allowProvisioningUpdates` plus the API key authorised xcodebuild to
    #    create one. That is where the "Created via API" Apple Development
    #    certificates came from: one per CI run, until the account hit Apple's cap
    #    and the build started failing. The ENV["CI"] branch above was never the
    #    hole — it guards Distribution certs, and no Distribution cert leaked.
    #
    #    The cert and all four profiles are in hand by this point, so point the
    #    archive at them and xcodebuild has nothing left to create. Two guards,
    #    because one of them is a build setting and build settings drift:
    #      a) every archived target signs manually against a named profile, and
    #      b) the archive no longer gets -allowProvisioningUpdates at all (the
    #         auth flags moved to export_xcargs), so even a target that somehow
    #         reverted to Automatic can only fail loudly, never mint a cert.
    #
    #    Why the pbxproj is edited here at runtime instead of in git:
    #      - the profile names are whatever sigh just produced (SIGH_NAME); a
    #        hardcoded PROVISIONING_PROFILE_SPECIFIER silently goes stale the
    #        next time a profile comes back under a different name,
    #      - a command-line build setting (xcargs) applies to EVERY target, and
    #        these four targets need four different profiles — there is no
    #        per-target form of an xcargs setting,
    #      - the committed project has to stay Automatic or Xcode on the laptop
    #        (signing against a personal Apple Development team) stops building.
    #    The edit is reverted in the ensure below, so it never reaches git.
    #
    #    Deliberately NOT gated on ENV["CI"]: the export step already requires
    #    exactly this cert and these profiles, so demanding them at archive time
    #    adds no new requirement to a laptop run — and it makes a local
    #    `fastlane beta` a faithful rehearsal of the CI archive, which is
    #    otherwise only observable on a paid macOS runner. The old divergence
    #    (local worked under Automatic) is what let this hide for so long.
    project_abs = File.expand_path("../#{XCODEPROJ}", __dir__)
    pbxproj = File.join(project_abs, "project.pbxproj")
    pbxproj_original = File.binread(pbxproj)

    begin
      signable.each do |target, bundle_id|
        update_code_signing_settings(
          path: project_abs,
          use_automatic_signing: false,
          targets: [target],
          build_configurations: ["Release"],
          team_id: TEAM_ID,
          code_sign_identity: "Apple Distribution",
          profile_name: profiles.fetch(bundle_id)
        )
      end

      # CODE_SIGN_STYLE (set above) is what xcodebuild reads; ProvisioningStyle
      # under TargetAttributes is the Xcode-8-era mirror of it, which
      # update_code_signing_settings leaves alone. Flip it too so nothing can
      # still read "Automatic" from anywhere in the project.
      proj = Xcodeproj::Project.open(project_abs)
      proj.root_object.attributes.fetch("TargetAttributes", {}).each_value do |attrs|
        attrs["ProvisioningStyle"] = "Manual" if attrs.key?("ProvisioningStyle")
      end
      proj.save

      # 5. Archive + export, manual signing on both. gym appends `xcargs` to the
      #    archive AND the export invocation but `export_xcargs` only to the
      #    export (gym/generators/package_command_generator_xcode7.rb) — so the
      #    auth flags live in export_xcargs alone. Putting them in both is what
      #    makes xcodebuild reject "-authenticationKeyID may only be provided
      #    once"; moving them is fine and is what keeps the archive unable to
      #    create signing assets.
      build_app(
        project: XCODEPROJ,
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        xcargs: "CURRENT_PROJECT_VERSION=#{build}",
        export_xcargs: export_auth_args,
        export_options: {
          signingStyle: "manual",
          signingCertificate: "Apple Distribution",
          provisioningProfiles: profiles
        }
      )
    ensure
      # Restore the checked-in signing config whatever happened, so a failed
      # build never leaves Manual/Distribution settings in the working tree.
      File.binwrite(pbxproj, pbxproj_original)
    end

    # 6. Upload. Internal testers on your team get it automatically once
    #    processing finishes (no App Review for internal testing).
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )

    UI.success("Uploaded build #{build} to TestFlight. It appears under " \
               "Internal Testing once App Store Connect finishes processing.")
  end

  desc "Build the native SwiftUI app (#{NATIVE_APP_IDENTIFIER}) and ship a build to TestFlight"
  lane :native_beta do
    # Same headless API-key signing as `beta` — no Apple ID password / 2FA.
    # Env contract (CI job uses the `testflight` GitHub environment):
    #   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH (p8 written to that path)
    #   CI=true, IOS_DIST_CERT_P12 / IOS_DIST_CERT_PASSWORD on CI
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    # 1. Cert setup — identical discipline to `beta` (see its comments for the
    #    full story): on CI import the team's single existing Distribution cert
    #    from a secret into a temp keychain so nothing mints new signing assets;
    #    locally fetch via the API key. `get_certificates` may only be used
    #    outside CI or it mints a new cert every run (Apple caps these).
    if ENV["CI"]
      setup_ci
      cert_path = File.expand_path("certs/dist.p12", __dir__)
      FileUtils.mkdir_p(File.dirname(cert_path))
      File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12")))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ""
      )
    else
      get_certificates(
        api_key: api_key,
        output_path: "fastlane/certs"
      )
    end

    # 2. Generate the Xcode project. Only project.yml is committed; the
    #    .xcodeproj is generated fresh on every run (same as native-swift.yml).
    UI.user_error!(
      "xcodegen is not installed — run `brew install xcodegen` first"
    ) unless system("which xcodegen >/dev/null 2>&1")
    sh("cd ../#{NATIVE_PROJECT_DIR} && xcodegen generate")

    # 3. Make sure the distribution material exists. All three steps are
    #    idempotent, so every run is safe and the first run is fully
    #    automated (no manual portal step — unlike the watch-widgets App
    #    Group, the capabilities the entitlements need can be enabled via
    #    the App Store Connect API).
    #
    #    a) The App ID. sigh does NOT create App IDs; the beta lane uses the
    #       same Spaceship call for the widget extensions.
    native_id = NATIVE_APP_IDENTIFIER
    bundle_ids = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: native_id })
    if bundle_ids.any? { |b| b.identifier == native_id }
      native_bundle_id = bundle_ids.find { |b| b.identifier == native_id }
    else
      native_bundle_id = Spaceship::ConnectAPI::BundleId.create(
        name: "Sendmeter Native",
        identifier: native_id,
        platform: "IOS"
      )
      UI.message("Registered App ID #{native_id}")
    end

    #    b) The capabilities SendmeterNative.entitlements requires. A profile
    #       generated without them fails at codesign ("profile doesn't
    #       include the entitlement"), so enable them up front.
    required_capabilities = {
      "HEALTHKIT" => "HealthKit",
      "APPLE_ID_AUTH" => "Sign in with Apple",
      "ASSOCIATED_DOMAINS" => "Associated Domains",
    }
    have = Spaceship::ConnectAPI::BundleIdCapability
      .all(bundle_id_id: native_bundle_id.id)
      .map(&:capability_type)
    required_capabilities.each do |type, label|
      next if have.include?(type)
      # Sign in with Apple is the one capability that requires a
      # configuration choice: ASC rejects a bare create with
      # "Please select at least one configuration for Sign in with Apple."
      # Enable as the primary App ID (the app IS the primary consumer).
      create_args = {
        bundle_id_id: native_bundle_id.id,
        capability_type: type
      }
      if type == "APPLE_ID_AUTH"
        create_args[:settings] = [
          {
            key: "APP_ID",
            options: [
              { key: "PRIMARY_APP_ID", enabled: true }
            ]
          }
        ]
      end
      Spaceship::ConnectAPI::BundleIdCapability.create(**create_args)
      UI.message("Enabled #{label} on #{native_id}")
    end

    #    c) The App Store Connect app record. latest_testflight_build_number
    #       and upload_to_testflight both fail on a missing app, so create it
    #       (SKU must be unique within the team).
    unless Spaceship::ConnectAPI::App.find(native_id)
      Spaceship::ConnectAPI::App.create(
        name: "Sendmeter Native",
        bundle_id: native_id,
        primary_locale: "en-US",
        sku: "SENDMETER-NATIVE",
        platforms: ["IOS"],
        version_string: "1.0.0"
      )
      UI.message("Created App Store Connect app record for #{native_id}")
    end

    # 4. App Store distribution profile carrying the cert from step 1.
    #    force: true regenerates it so it always pins the current cert —
    #    same reason as the beta lane (the account's auto Team Store profile
    #    referenced an older cert). sigh installs the profile locally, which
    #    is what lets the archive resolve it by name in step 6.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: native_id,
      force: true,
      output_path: "fastlane/certs"
    )
    native_profile = lane_context[SharedValues::SIGH_NAME]

    # 5. Next build number = latest on TestFlight (of THIS app — the native
    #    app has its own build-number train, so it can never race `beta`) + 1.
    #    Applied at archive time via xcargs; NEVER hand-bump
    #    CURRENT_PROJECT_VERSION in project.yml.
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: native_id,
      initial_build_number: 0
    ) + 1

    # 6. Pin the ARCHIVE to manual signing (#263 discipline, single target).
    #    The beta lane edits the shipped pbxproj at runtime and restores it in
    #    an ensure; here the project is generated by this lane and untracked,
    #    so the edit needs no restore — the next run regenerates it. The
    #    committed project.yml stays Automatic so local Xcode development
    #    keeps working. The auth flags are deliberately export-only (gym
    #    appends xcargs to BOTH invocations but export_xcargs to the export
    #    only), so the archive has no authority to create signing assets.
    native_project_abs = File.expand_path("../#{NATIVE_XCODEPROJ}", __dir__)
    update_code_signing_settings(
      path: native_project_abs,
      use_automatic_signing: false,
      targets: [NATIVE_SCHEME],
      build_configurations: ["Release"],
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: native_profile
    )
    native_proj = Xcodeproj::Project.open(native_project_abs)
    native_proj.root_object.attributes.fetch("TargetAttributes", {}).each_value do |attrs|
      attrs["ProvisioningStyle"] = "Manual" if attrs.key?("ProvisioningStyle")
    end
    native_proj.save

    key_abs = File.expand_path(File.basename(ENV.fetch("ASC_KEY_PATH")), __dir__)
    export_auth_args = "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
                       "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')} " \
                       "-authenticationKeyPath #{key_abs} -allowProvisioningUpdates"

    build_app(
      project: NATIVE_XCODEPROJ,
      scheme: NATIVE_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      export_xcargs: export_auth_args,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { native_id => native_profile }
      }
    )

    # 7. Upload. Guy needs to be an internal tester of the NEW app record
    #    ("Sendmeter Native", com.jirathip.sendlog.native) once in App Store
    #    Connect — internal testers are per-app, so the shipped app's tester
    #    list does not carry over.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: native_id,
      skip_waiting_for_build_processing: true
    )

    UI.success("Uploaded native build #{build} to TestFlight under " \
               "#{native_id}. It appears under Internal Testing once App " \
               "Store Connect finishes processing.")
  end
end
