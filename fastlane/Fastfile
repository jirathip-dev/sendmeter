require "base64"
require "fileutils"
require "json"
require "shellwords"
require "xcodeproj"

default_platform(:ios)

APP_IDENTIFIER = "com.jirathip.sendlog".freeze
# The native project is generated from project.yml and embeds the retained Watch companion.
SHIPPED_APP_IDENTIFIER = APP_IDENTIFIER.freeze
SHIPPED_WIDGETS_IDENTIFIER = "#{SHIPPED_APP_IDENTIFIER}.widgets".freeze
NATIVE_APP_IDENTIFIER = "com.jirathip.sendlog.native".freeze
NATIVE_WIDGETS_IDENTIFIER = "#{NATIVE_APP_IDENTIFIER}.widgets".freeze
NATIVE_PROJECT_DIR = "native/SendmeterNative".freeze
NATIVE_XCODEPROJ = "#{NATIVE_PROJECT_DIR}/SendmeterNative.xcodeproj".freeze
NATIVE_SCHEME = "SendmeterNative".freeze
NATIVE_WIDGETS_TARGET = "SendmeterNativeWidgets".freeze
TEAM_ID = "9244PWFYD7".freeze
WATCH_APP_GROUP = "group.com.jirathip.sendlog".freeze

def require_manual_watch_capabilities!(bundle_id:, label:, required:, portal_steps:)
  record = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: bundle_id })
    .find { |candidate| candidate.identifier == bundle_id }
  UI.user_error!("App ID #{bundle_id} for #{label} was not found") unless record

  begin
    have = Spaceship::ConnectAPI::BundleIdCapability
      .all(bundle_id_id: record.id)
      .map(&:capability_type)
  rescue StandardError => error
    UI.user_error!(
      "Could not verify the manually-managed capabilities for #{label} " \
      "(#{bundle_id}): #{error.message}. Check the Apple Developer portal " \
      "before retrying; native_beta will not fetch a profile blindly."
    )
  end

  missing = required - have
  return if missing.empty?

  UI.user_error!(
    "#{label} (#{bundle_id}) is missing #{missing.join(', ')}. " \
    "Complete this manual Apple Developer portal setup, then rerun: " \
    "#{portal_steps} native_beta only registers IDs and verifies these " \
    "capabilities; it cannot enable App Groups or attach #{WATCH_APP_GROUP}."
  )
end

platform :ios do
  desc "Build the native SwiftUI app (#{SHIPPED_APP_IDENTIFIER}) and ship a build to TestFlight"
  lane :native_beta do
    # Same headless API-key signing as native TestFlight.
    # Env contract (CI job uses the `testflight` GitHub environment):
    #   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH (p8 written to that path)
    #   CI=true, IOS_DIST_CERT_P12 / IOS_DIST_CERT_PASSWORD on CI
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    # 1. Cert setup — import the team's existing distribution certificate on CI;
    if ENV["CI"]
      setup_ci
      cert_path = File.expand_path("certs/dist.p12", __dir__)
      FileUtils.mkdir_p(File.dirname(cert_path))
      File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12")))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ""
      )
    else
      get_certificates(
        api_key: api_key,
        output_path: "fastlane/certs"
      )
    end

    # 2. Generate the Xcode project. The project spec and native resource
    #    inputs are committed; the .xcodeproj is generated fresh on every run
    #    (same as native-swift.yml).
    UI.user_error!(
      "xcodegen is not installed — run `brew install xcodegen` first"
    ) unless system("which xcodegen >/dev/null 2>&1")
    sh("cd ../#{NATIVE_PROJECT_DIR} && xcodegen generate")

    # 3. Make sure the distribution material exists. Phone/widget App ID
    #    registration and the phone capabilities are idempotent. Watch App ID
    #    registration is also safe, but its HealthKit/App Group setup is a
    #    deliberate manual Apple Developer portal prerequisite (see below).
    #
    #    a) The App IDs. sigh does NOT create App IDs; the beta lane uses
    #       the same Spaceship call for the widget extensions. The archive
    #       embeds the widget appex too,
    #       so it is every bit as signable as the app itself — an unregistered
    #       App ID makes its profile fetch fail and the whole lane die (#674).
    native_id = SHIPPED_APP_IDENTIFIER
    widgets_id = SHIPPED_WIDGETS_IDENTIFIER
    [
      [native_id, "Sendmeter"],
      [widgets_id, "Sendmeter Widgets"],
    ].each do |id, name|
      existing = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: id })
      unless existing.any? { |b| b.identifier == id }
        Spaceship::ConnectAPI::BundleId.create(name: name, identifier: id, platform: "IOS")
        UI.message("Registered App ID #{id}")
      end
    end
    native_bundle_id = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: native_id })
      .find { |b| b.identifier == native_id }

    #    b) The capabilities SendmeterNative.entitlements requires. A profile
    #       generated without them fails at codesign ("profile doesn't
    #       include the entitlement"), so enable them up front.
    required_capabilities = {
      "HEALTHKIT" => "HealthKit",
      "APPLE_ID_AUTH" => "Sign in with Apple",
      "ASSOCIATED_DOMAINS" => "Associated Domains",
    }
    have = Spaceship::ConnectAPI::BundleIdCapability
      .all(bundle_id_id: native_bundle_id.id)
      .map(&:capability_type)
    required_capabilities.each do |type, label|
      next if have.include?(type)
      # Sign in with Apple is the one capability that requires a
      # configuration choice: ASC rejects a bare create with
      # "Please select at least one configuration for Sign in with Apple."
      # Enable as the primary App ID (the app IS the primary consumer).
      create_args = {
        bundle_id_id: native_bundle_id.id,
        capability_type: type
      }
      if type == "APPLE_ID_AUTH"
        # Current ASC schema: SIWA consent setting is
        # APPLE_ID_AUTH_APP_CONSENT → PRIMARY_APP_CONSENT (the legacy
        # APP_ID → PRIMARY_APP_ID keys were removed from the API).
        create_args[:settings] = [
          {
            key: "APPLE_ID_AUTH_APP_CONSENT",
            options: [
              { key: "PRIMARY_APP_CONSENT", enabled: true }
            ]
          }
        ]
      end
      Spaceship::ConnectAPI::BundleIdCapability.create(**create_args)
      UI.message("Enabled #{label} on #{native_id}")
    end

    #    c) The App Store Connect app record. For the shipped ID this exists
    #       already; the fallback create keeps the lane self-contained without
    #       making this task register anything.
    unless Spaceship::ConnectAPI::App.find(native_id)
      Spaceship::ConnectAPI::App.create(
        name: "Sendmeter",
        bundle_id: native_id,
        primary_locale: "en-US",
        sku: "SENDMETER",
        platforms: ["IOS"],
        version_string: "1.0.0"
      )
      UI.message("Created App Store Connect app record for #{native_id}")
    end

    # 4. App Store distribution profiles carrying the cert from step 1 — one
    #    for the app, embedded watch app, phone widget appex, and embedded
    #    watch widget appex. force: true regenerates them so they always pin
    #    the current cert — same reason as the beta lane (the account's auto
    #    Team Store profile referenced an older cert). sigh installs each
    #    profile locally, which is what lets the archive resolve them by name
    #    in step 6. The App IDs are registered here, but the watch capabilities
    #    are read-only verified below because this API cannot enable App Groups
    #    or attach the group container.
    watch_app_id = "#{native_id}.watchkitapp"
    watch_widgets_id = "#{watch_app_id}.widgets"
    watch_target = "SendLogWatch Watch App"
    watch_widgets_target = "SendLogWatchWidgets"
    watch_app_record = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: watch_app_id })
    unless watch_app_record.any? { |b| b.identifier == watch_app_id }
      Spaceship::ConnectAPI::BundleId.create(
        name: "Sendmeter Watch",
        identifier: watch_app_id,
        platform: "IOS"
      )
      UI.message("Registered App ID #{watch_app_id}")
    end
    watch_widgets_record = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: watch_widgets_id })
    unless watch_widgets_record.any? { |b| b.identifier == watch_widgets_id }
      Spaceship::ConnectAPI::BundleId.create(
        name: "Sendmeter Watch Widgets",
        identifier: watch_widgets_id,
        platform: "IOS"
      )
      UI.message("Registered App ID #{watch_widgets_id}")
    end

    require_manual_watch_capabilities!(
      bundle_id: watch_app_id,
      label: watch_target,
      required: %w[HEALTHKIT APP_GROUPS],
      portal_steps: "On #{watch_app_id}, enable HealthKit and App Groups; add #{WATCH_APP_GROUP}."
    )
    require_manual_watch_capabilities!(
      bundle_id: watch_widgets_id,
      label: watch_widgets_target,
      required: %w[APP_GROUPS],
      portal_steps: "On #{watch_widgets_id}, enable App Groups and add #{WATCH_APP_GROUP}."
    )

    profiles = {}
    [native_id, watch_app_id, widgets_id, watch_widgets_id].each do |bundle_id|
      begin
        get_provisioning_profile(
          api_key: api_key,
          app_identifier: bundle_id,
          force: true,
          output_path: "fastlane/certs"
        )
      rescue StandardError => error
        unless [watch_app_id, watch_widgets_id].include?(bundle_id)
          raise
        end
        UI.user_error!(
          "Could not fetch the distribution profile for #{bundle_id}: " \
          "#{error.message}. Confirm the manually-managed HealthKit/App " \
          "Group capability and #{WATCH_APP_GROUP} attachment in the Apple " \
          "Developer portal; native_beta cannot repair that configuration."
        )
      end
      profiles[bundle_id] = lane_context[SharedValues::SIGH_NAME]
    end

    # 5. Next build number = latest on TestFlight of the shipped app + 1.
    #    `beta` and `native_beta` now target the same record, so their build
    #    numbers share one train; only one lane should run per release.
    #    Applied at archive time via xcargs; NEVER hand-bump
    #    CURRENT_PROJECT_VERSION in project.yml.
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: native_id,
      initial_build_number: 0
    ) + 1

    # 6. Pin the ARCHIVE to manual signing (#263 discipline, FOUR targets now).
    #    The beta lane edits the shipped pbxproj at runtime and restores it in
    #    an ensure; here the project is generated by this lane and untracked,
    #    so the edit needs no restore — the next run regenerates it. The
    #    committed project.yml stays Automatic so local Xcode development
    #    keeps working. The auth flags are deliberately export-only (gym
    #    appends xcargs to BOTH invocations but export_xcargs to the export
    #    only), so the archive has no authority to create signing assets.
    native_project_abs = File.expand_path("../#{NATIVE_XCODEPROJ}", __dir__)
    # The signable map mirrors the beta lane's: target => bundle id, so the
    # archive pin and the export profiles cannot drift apart. Every target the
    # archive embeds must sign manually against its own profile; an embedded
    # watch app or widget appex left on Automatic would fail with "Signing ...
    # requires a development team" and the archive has no
    # -allowProvisioningUpdates to recover.
    signable = {
      NATIVE_SCHEME => native_id,
      watch_target => watch_app_id,
      NATIVE_WIDGETS_TARGET => widgets_id,
      watch_widgets_target => watch_widgets_id,
    }
    signable.each do |target, bundle_id|
      update_code_signing_settings(
        path: native_project_abs,
        use_automatic_signing: false,
        targets: [target],
        build_configurations: ["Release"],
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profiles.fetch(bundle_id)
      )
    end
    native_proj = Xcodeproj::Project.open(native_project_abs)
    native_proj.root_object.attributes.fetch("TargetAttributes", {}).each_value do |attrs|
      attrs["ProvisioningStyle"] = "Manual" if attrs.key?("ProvisioningStyle")
    end
    native_proj.save

    key_abs = File.expand_path(File.basename(ENV.fetch("ASC_KEY_PATH")), __dir__)
    export_auth_args = "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
                       "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')} " \
                       "-authenticationKeyPath #{key_abs} -allowProvisioningUpdates"

    build_app(
      project: NATIVE_XCODEPROJ,
      scheme: NATIVE_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      export_xcargs: export_auth_args,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        # Manual export requires a profile for EVERY embedded bundle — the
        # watch app and widget appex included — or exportArchive fails
        # "profile not found".
        provisioningProfiles: profiles
      }
    )

    # 7. Upload. This uses the existing shipped App Store record, so internal
    #    tester membership already applies to the upload.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: native_id,
      skip_waiting_for_build_processing: true
    )

    UI.success("Uploaded native build #{build} to TestFlight under " \
               "#{native_id}. It appears under Internal Testing once App " \
               "Store Connect finishes processing.")
  end
end
