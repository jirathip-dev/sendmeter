<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- The Live Activity extension only renders the ActivityAttributes /
	     ContentState the app process pushes to it. It collects nothing. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- No required-reason API here. This bundle has no App Group and its
	     Button(intent:) implementations are no-op stubs (IntentStubs.swift) —
	     LiveActivityIntent.perform() runs in the App process, so the
	     UserDefaults pending-action queue is declared in the App's manifest.
	     Not strictly required by Apple (a bundle that uses no required-reason
	     API needs no manifest), but kept so every shipped bundle states its
	     position explicitly. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
