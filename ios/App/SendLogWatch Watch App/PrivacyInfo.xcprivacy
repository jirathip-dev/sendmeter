<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Subset of the phone app's table (docs/app-store-checklist.md): the watch
	     uploads workouts/attempts and Tindeq recordings, but never collects the
	     account email and never writes auth diagnostics. It no longer reads
	     HealthKit for health metrics — the iPhone is the sole writer of those. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Live + summary heart rate captured during a climbing workout. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Workout duration, boulder attempts, training load. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Session logs, tags/RPE, Tindeq force recordings. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- CA92.1 — UserDefaults.standard, private to this bundle:
		       Services/WorkoutManager.swift (restTargetS)
		       Views/ForceGaugeView.swift (last tag/side)
		       SendLogWatchCore/RPEModel.swift (statically linked)
		     1C8F.1 — UserDefaults(suiteName: "group.com.jirathip.sendlog") in
		     Shared/WidgetShared.swift, written for SendLogWatchWidgets to read.
		     That write is readable by another bundle, so CA92.1 does not cover
		     it; both reasons are required. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
		<!-- C617.1 — creationDateKey on files inside this app's own container:
		     Services/UploadQueueEngine.swift (the one queue implementation behind
		     OfflineQueue / PendingSessionQueue / PendingRecordingQueue, #491) sorts
		     Documents/pending{,-sessions,-recordings}/*.json oldest-first before
		     draining and picks the oldest file when evicting. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
