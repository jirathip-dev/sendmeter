diff --git a/native/SendmeterNative/Sources/Platform/TindeqBluetooth.swift b/native/SendmeterNative/Sources/Platform/TindeqBluetooth.swift
index 74219c0..45fa195 100644
--- a/native/SendmeterNative/Sources/Platform/TindeqBluetooth.swift
+++ b/native/SendmeterNative/Sources/Platform/TindeqBluetooth.swift
@@ -711,3 +711,21 @@ extension TindeqBluetooth.Status {
         }
     }
 }
+
+#if DEBUG
+extension TindeqBluetooth {
+    /// #1038 design-round harness only (`--design-1038`, DEBUG) — the base
+    /// copy: sets the published transport state directly.
+    func designFixtureSet(status: Status, samples: [TindeqSample] = []) {
+        sampleBuffer.removeAll()
+        for sample in samples { sampleBuffer.append(sample) }
+        visibleSampleRange = samples.isEmpty ? 0..<0 : sampleBuffer.visibleRange()
+        let values = samples.map(\.kilograms)
+        currentKilograms = values.last ?? 0
+        peakKilograms = values.max() ?? 0
+        averageKilograms = values.isEmpty ? 0 : values.reduce(0, +) / Double(values.count)
+        elapsedMilliseconds = samples.last?.milliseconds ?? 0
+        self.status = status
+    }
+}
+#endif
