+#if DEBUG
+extension AppModel {
+    /// #1038 design-round harness only (`--design-1038`, DEBUG) — the base
+    /// copy: publishes a deterministic account snapshot so the real Force tab
+    /// renders the owner's state without a backend.
+    func designFixtureSeed(
+        sessions: [SendmeterCore.Session],
+        healthMetrics: [HealthMetric],
+        presets: [TindeqPreset],
+        recordings: [TindeqRecording],
+        healthSyncedAt: Date?
+    ) {
+        self.sessions = sessions
+        hasLoadedSessions = true
+        self.healthMetrics = healthMetrics
+        self.presets = presets
+        self.recordings = recordings
+        hasLoadedRecordings = true
+        lastHealthSyncedAt = healthSyncedAt
+        forceModel.hasLoadedRecordings = true
+    }
+
+    /// The fitted static curves the suggested zones read (same code as the
+    /// after harness).
+    func designFixtureSetTagCurves(_ curves: [TagForceCurve]) {
+        for curve in curves {
+            tagCurveCache[TagCurveCacheKey(tag: curve.tag, modality: curve.modality)] = curve
+        }
+        publishTagCurves()
+    }
+}
+#endif
